# Shared values read by docker-compose for ${VAR} substitution.
BACKEND_PORT=3000
FRONTEND_PORT=8080
LOCALSTACK_PORT=4566
# PostgreSQL: used by the postgres container and by the backend (compose passes them through;
# a backend run outside Docker reads this file via ../.env, host = localhost).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tours
POSTGRES_PASSWORD=tours
POSTGRES_DB=tours
# Admin = POSTGRES_USER (superuser, init only). The backend connects as this limited role instead.
APP_DB_USER=tours_app
APP_DB_PASSWORD=tours_app
