PORT=3000

# Every AWS SDK client is forced to this endpoint (LocalStack). Inside docker-compose it is overridden to http://localstack:4566.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

EVENT_BUS_NAME=travel-app-event-bus
EVENT_QUEUE_NAME=travel-app-event-queue
EVENT_RULE_NAME=travel-app-forward-all
