PORT=3000

# Every AWS SDK client is forced to this endpoint (LocalStack). Inside docker-compose it is overridden to http://localstack:4566.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

EVENT_BUS_NAME=travel-app-event-bus
EVENT_QUEUE_NAME=travel-app-event-queue
EVENT_RULE_NAME=travel-app-forward-all

# PostgreSQL settings (POSTGRES_*) live only in the root .env. When running the backend
# outside Docker it reads them from ../.env, with POSTGRES_HOST defaulting to localhost.

# Auth. Change the secret outside local development.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN_SECONDS=3600

# How often (seconds) the job that announces overdue Pending requests runs. 0 disables it.
VACATION_EXPIRY_INTERVAL_SECONDS=600

# Outbox relay: how often (ms) recorded events are published to the bus (0 disables it), and how many
# days published rows are kept before they are purged.
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_RETENTION_DAYS=7

# Queue behaviour. A message that fails EVENT_MAX_RECEIVE_COUNT times moves to the dead-letter queue
# (default name: <EVENT_QUEUE_NAME>-dlq, override with EVENT_DLQ_NAME).
EVENT_MAX_RECEIVE_COUNT=5
EVENT_VISIBILITY_TIMEOUT_SECONDS=30

# Dev-only, unauthenticated /api/test/* endpoints (they expose event payloads). Keep false outside local development.
ENABLE_TEST_ENDPOINTS=true

